  shorttitle = {The {{Semantic}} of {{Business Vocabulary}} and {{Business Rules}}},
  author = {Haj, Abdellatif and Jarrar, Abdessamd and Balouki, Youssef and Gadir, Taoufiq},
  date = {2021},
  journaltitle = {IEEE Access},
  volume = {9},
